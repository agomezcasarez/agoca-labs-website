---
import '../styles/agoca.css';
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#0b1020" /><title>{title}</title><link rel="canonical" href={canonical} /><link rel="icon" href="/agoca.svg" type="image/svg+xml" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} /></head><body><a class="skip" href="#main">Skip to content</a><header class="wrap"><a class="brand" href="/" aria-label="Agoca Labs home"><span class="brand-mark" aria-hidden="true">a.</span>agoca<span class="brand-labs">labs</span></a><nav aria-label="Main navigation"><a href="/#work">Our work</a><a href="/privacy/" aria-current={Astro.url.pathname.startsWith('/privacy') ? 'page' : undefined}>Privacy</a></nav></header><main id="main"><slot /></main><footer class="wrap"><a class="brand" href="/">agoca<span class="brand-labs">labs</span></a><p>Independent thinking. Everyday applications.</p><a href="/privacy/">Privacy policy</a><small>© {new Date().getFullYear()} Agoca Labs</small></footer></body></html>
