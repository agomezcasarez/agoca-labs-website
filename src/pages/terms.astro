const sections = [['agreement','Agreement'],['services','Services'],['accounts','Connected accounts'],['content','Creator content'],['use','Acceptable use'],['third-parties','Third-party services'],['availability','Availability'],['disclaimers','Disclaimers'],['changes','Changes'],['contact','Contact']];
